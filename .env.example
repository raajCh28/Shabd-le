# Use a unique secret generated with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret

# SMTP settings for verification emails (STARTTLS on port 587 is typical).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Shabdle <no-reply@example.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional database URL. Defaults to local SQLite.
# DATABASE_URL=sqlite:///./wordle.db
